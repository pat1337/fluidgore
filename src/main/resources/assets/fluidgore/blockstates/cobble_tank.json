{
  "multipart": [
    {"when": {"facing": "up"}, "apply": {"model": "fluidgore:block/cobble_tank", "x": 0, "y": 0}},
    {"when": {"facing": "down"}, "apply": {"model": "fluidgore:block/cobble_tank", "x": 180, "y": 0}},
    {"when": {"facing": "north"}, "apply": {"model": "fluidgore:block/cobble_tank", "x": 90, "y": 0}},
    {"when": {"facing": "south"}, "apply": {"model": "fluidgore:block/cobble_tank", "x": 90, "y": 180}},
    {"when": {"facing": "west"}, "apply": {"model": "fluidgore:block/cobble_tank", "x": 90, "y": 270}},
    {"when": {"facing": "east"}, "apply": {"model": "fluidgore:block/cobble_tank", "x": 90, "y": 90}},
    {"when": {"scars": "1"}, "apply": {"model": "fluidgore:block/cobble_tank_scars_1"}},
    {"when": {"scars": "2"}, "apply": {"model": "fluidgore:block/cobble_tank_scars_2"}},
    {"when": {"scars": "3"}, "apply": {"model": "fluidgore:block/cobble_tank_scars_3"}}
  ]
}
